---
import Layout from '../layouts/Layout.astro';
import { fade } from 'astro:transitions';
import StorefrontApp from '../components/StorefrontApp.tsx';

// Fetch the homepage layout from the NestJS backend
const API_URL = import.meta.env.PUBLIC_API_URL || 'http://dc-backend:4000/api';

let layoutData = [];
let products = [];
try {
  const layoutRes = await fetch(`${API_URL}/cms/layout/homepage_layout`);
  
  if (layoutRes.ok) {
    const json = await layoutRes.json();
    layoutData = json.layout || [];
  }

  // Fetch products based on IDs provided in metadata
  const bestSellersBlock = layoutData.find((l: any) => l.type === 'best_sellers' || l.metadata?.productIds);
  const rawProductIds = bestSellersBlock?.metadata?.productIds || '';
  const productIds = Array.isArray(rawProductIds) ? rawProductIds.join(',') : rawProductIds;

  const productsRes = await fetch(`${API_URL}/products/bulk?ids=${productIds}`);
  if (productsRes.ok) {
    products = await productsRes.json();
  }
} catch (error) {
  console.error("Failed to fetch Astro homepage data:", error);
}
---

<Layout title="Divine Cardinal - Unmatched SEO Storefront">
  <main>
    <div class="storefront-wrapper">
      <StorefrontApp client:load banners={layoutData.filter((l: any) => l.type === 'banner')} bestSellers={products} initialLayout={layoutData} />
    </div>
  </main>
</Layout>
